CONFIG__GIT_PROVIDER=gitea
CONFIG__RESPONSE_LANGUAGE=zh-CN
CONFIG__LOG_LEVEL=INFO

GITEA__URL=http://gitea:3000
GITEA__WEB_URL=http://gitea.xxx.com
GITEA__PERSONAL_ACCESS_TOKEN='xxx' # 一次性获取：gitea->右上角头像->设置->应用->令牌(read:user、read:repository、write:issue)
GITEA__WEBHOOK_SECRET='xxx' # 自定义获取：gitea->仓库->设置->Web钩子->密钥

OPENAI__API_BASE='https://xxx.xxx.xxx/v1' # openai接口地址
OPENAI__KEY='xxx' # openai接口密钥
CONFIG__MODEL='openai/xxx' # openai接口模型
CONFIG__FALLBACK_MODELS=[]
CONFIG__CUSTOM_MODEL_MAX_TOKENS=16000
CONFIG__MAX_MODEL_TOKENS=16000

GITEA__PR_COMMANDS=["/review"]
GITEA__HANDLE_PUSH_TRIGGER=true
GITEA__PUSH_COMMANDS=["/review"]
